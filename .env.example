# Server-only secrets. Never prefix these with VITE_ or commit .env.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
RESEND_API_KEY=
# Must use an address on your verified Resend sending domain.
MAIL_FROM=
LEAD_EMAIL=yosef2112@gmail.com
PORT=3001
HOST=127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Required in production. Review final privacy wording and retention first.
PRIVACY_REVIEWED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# One server instance: bounded in-memory daily image quota, resets on restart.
MAX_DAILY_IMAGES=30
MAX_ACTIVE_SMILE_JOBS=2
# Set only when your hosting provider's trusted proxy count is known.
TRUST_PROXY_HOPS=
# Enable only after the clinic confirms the exact financing terms.
OFFER_APPROVED=false
# Public URL of the separately deployed API. Leave empty for the local server.
VITE_API_BASE_URL=
# Exact frontend origins allowed to call the API, comma-separated.
ALLOWED_ORIGINS=https://dental-care24.com,https://www.dental-care24.com
